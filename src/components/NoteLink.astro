---
import { getNoteLinkPreview } from '../lib/note-link';

interface Props {
  href?: string;
}

const { href } = Astro.props;
const preview = href ? await getNoteLinkPreview(href) : undefined;
---

{preview && (
  <a class="note-link" href={href} target="_blank" rel="noopener noreferrer">
    <span class="note-link-icon" aria-hidden="true">
      ↗
      {preview.icon && (
        <img
          src={preview.icon}
          alt=""
          width="14"
          height="14"
          loading="lazy"
          referrerpolicy="no-referrer"
          onerror="this.remove()"
        />
      )}
    </span>
    <span>{preview.title}</span>
  </a>
)}

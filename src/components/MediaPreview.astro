<dialog class="media-preview" id="media-preview" aria-label="图片预览">
  <div class="media-preview-panel">
    <form method="dialog">
      <button class="media-preview-close" type="submit" aria-label="关闭图片预览" autofocus>×</button>
    </form>
    <div class="media-preview-photo">
      <img class="media-preview-image" alt="" />
      <video class="media-preview-video" loop muted playsinline preload="none"
        disablepictureinpicture disableremoteplayback aria-hidden="true"></video>
      <button class="media-preview-motion" type="button" aria-label="实况动画" aria-pressed="false" hidden>
        <span class="live-photo-mark" aria-hidden="true"></span>
      </button>
    </div>
    <p class="media-preview-status" role="status" hidden>实况动画暂时无法播放，已显示静态照片。</p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#media-preview');
  const image = dialog?.querySelector<HTMLImageElement>('.media-preview-image');
  const motion = dialog?.querySelector<HTMLVideoElement>('.media-preview-video');
  const toggle = dialog?.querySelector<HTMLButtonElement>('.media-preview-motion');
  const status = dialog?.querySelector<HTMLElement>('.media-preview-status');

  if (dialog && image && motion && toggle && status) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    motion.addEventListener('playing', () => {
      motion.classList.add('is-playing');
      toggle.setAttribute('aria-pressed', 'true');
    });
    motion.addEventListener('pause', () => {
      motion.classList.remove('is-playing');
      toggle.setAttribute('aria-pressed', 'false');
    });

    toggle.addEventListener('click', () => {
      if (motion.paused) {
        // Keep the cover visible until the animation actually starts.
        void motion.play().catch(() => {});
      } else {
        motion.pause();
      }
    });

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[data-media-preview]');
      if (!link || typeof dialog.showModal !== 'function') return;

      event.preventDefault();
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt ?? '';
      const source = link.dataset.motion;
      toggle.hidden = !source;
      status.hidden = true;

      dialog.showModal();
      if (source) {
        motion.src = source;
        if (!reduceMotion.matches) void motion.play().catch(() => {});
      }
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      motion.pause();
      motion.classList.remove('is-playing');
      toggle.setAttribute('aria-pressed', 'false');
      motion.removeAttribute('src');
      motion.load();
      image.removeAttribute('src');
    });
    motion.addEventListener('error', () => {
      if (!dialog.open || !motion.hasAttribute('src')) return;
      motion.classList.remove('is-playing');
      if (document.activeElement === toggle) dialog.querySelector<HTMLButtonElement>('.media-preview-close')?.focus();
      toggle.hidden = true;
      status.hidden = false;
    });
  }
</script>
